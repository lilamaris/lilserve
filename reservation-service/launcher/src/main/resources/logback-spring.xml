<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty name="OTLP_LOG_ENDPOINT"
                    source="management.opentelemetry.logging.export.otlp.endpoint"
                    defaultValue = ""/>

    <root level="${ROOT_LOG_LEVEL:-INFO}">
        <appender-ref ref="CONSOLE"/>
    </root>

    <condition class="ch.qos.logback.core.boolex.ExpressionPropertyCondition">
        <expression>!propertyEquals("OTLP_LOG_ENDPOINT", "")</expression>
    </condition>
    <if>
        <then>
            <appender name="OTEL"
                      class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender"/>

            <root>
                <appender-ref ref="OTEL"/>
            </root>
        </then>
    </if>
</configuration>
