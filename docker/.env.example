# Copy this file to .env at the repo root before docker compose up -d.
# Compose reads .env for interpolation and passes entries to the app.
# Spring Boot itself does not read this file; Compose passes the values on.

# Host binding for the app. Loopback keeps them local.
BIND_HOST=127.0.0.1
APP_BIND_PORT=8080

# Image tag to run. Use docker compose pull to fetch the registry image.
# For local changes, run ./gradlew :reservation-service:launcher:bootJar
# before docker compose up -d --build. Use a commit SHA to pin the image.
APP_IMAGE_TAG=latest

# Database name and shared application/database credentials. These match the
# Compose defaults. An existing volume keeps the password it was created with:
# after changing it, run docker compose down -v or ALTER ROLE in PostgreSQL.
POSTGRES_DB=lilserve
LILSERVE_DATASOURCE_USERNAME=lilserve
LILSERVE_DATASOURCE_PASSWORD=lilserve

# Optional JDBC override; Compose defaults to its service name.
# PostgreSQL is available only on the Compose network; no host port is published.
# LILSERVE_DATASOURCE_URL=jdbc:postgresql://postgres:5432/lilserve
LILSERVE_TIMEZONE=UTC

# Actuator port in the container and on the host; keep it off 8080.
LILSERVE_MANAGEMENT_SERVER_PORT=8081
# For remote scraping, use the app host's private IP and allow only
# Prometheus through the firewall. Independent of BIND_HOST.
MANAGEMENT_BIND_HOST=127.0.0.1

# Tracing sample rate, 0.0-1.0. Keep 1 locally, 0.1 in production.
LILSERVE_TRACING_SAMPLING=1

# Opt-in OTLP/HTTP destinations, both targeting Alloy. Uncomment both and
# replace <host> with the monitoring host's private address, reachable
# from the container:
#   MANAGEMENT_OPENTELEMETRY_LOGGING_EXPORT_OTLP_ENDPOINT=http://<host>:4318/v1/logs
#   MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_ENDPOINT=http://<host>:4318/v1/traces
# Unset names build no exporter, so logs and traces are not sent. An empty
# value fails startup, so never leave a value blank.
